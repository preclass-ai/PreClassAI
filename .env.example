# Copy to a local, untracked .env file. Never commit real values.
NODE_ENV=development
DATABASE_URL=postgresql+asyncpg://preclass:preclass@127.0.0.1:5432/preclass
TEST_DATABASE_URL=postgresql+asyncpg://preclass:preclass@127.0.0.1:5432/preclass_test
APP_ENV=development
COOKIE_SECURE=false
SESSION_SECRET=replace-with-a-local-random-value
FRONTEND_ORIGIN=http://localhost:3000   # only for split-origin dev
UPLOAD_DIR=./data/uploads
LLM_PROVIDER=mock                       # mock | openai_compatible
LLM_BASE_URL=https://example.invalid
LLM_API_KEY=local-only-placeholder
LLM_MODEL=
MOCK_INJECT=
AI_ENABLED=true
GENERATION_DAILY_TOKEN_BUDGET=300000
BACKUP_ENCRYPTION_KEY=local-only-placeholder
PYTHONUTF8=1
