{
  "name": "@preclass/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client for the PreClass API (generated from apps/api/openapi/openapi.json)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "gen:api": "openapi-typescript ../../apps/api/openapi/openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0"
  }
}
