# Copy to infra/.env.staging on the host; never commit the real file.
POSTGRES_DB=preclass
POSTGRES_USER=preclass
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://preclass:change-me@postgres:5432/preclass
SESSION_SECRET=change-me
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
AI_ENABLED=true
GENERATION_DAILY_TOKEN_BUDGET=300000
APP_HOSTNAME=localhost
TLS_CONTACT_EMAIL=ops@example.invalid
IMAGE_TAG=dev
APP_ENV=staging
COOKIE_SECURE=true
# Must equal https://$APP_HOSTNAME (the API's CSRF Origin check)
FRONTEND_ORIGIN=https://localhost
# Demo seed: staging only (the seed refuses APP_ENV=production)
SEED_DEMO=true
SEED_PASSWORD=change-me
